# 复制为 .env 并填入真实值（切勿提交到 git / 分享给任何人）
DATABASE_URL="postgresql://用户:密码@主机:6543/postgres"  # Supabase 的 Transaction pooler 连接串
AUTH_SECRET="请替换为随机长字符串，可用 openssl rand -base64 32 生成"
ANTHROPIC_API_KEY="sk-ant-..."
DEEPSEEK_API_KEY="sk-..."

# 可选：验证码真实发送渠道（不配置则为开发模式，验证码打印在服务器控制台）
# RESEND_API_KEY="re_..."        # 邮箱验证码，https://resend.com 免费额度即可
# MAIL_FROM="noreply@你的域名"
# SMS_ACCESS_KEY=""              # 手机短信：需阿里云/腾讯云短信签名审批后接入

# 管理员账号（逗号分隔）。用该邮箱/手机号正常注册登录后，即可访问 /admin 管理后台
ADMIN_ACCOUNTS="you@example.com"

# ===== Claude 中继（长期国内部署时启用，见 RELAY.md）=====
# 中继侧（境外节点）配置：
# RELAY_TOKEN="随机长字符串，与调用方一致"
# 调用侧（国内网关）配置：
# ANTHROPIC_BASE_URL="https://中继域名/api/relay/anthropic/v1"
# ANTHROPIC_RELAY_TOKEN="与中继侧 RELAY_TOKEN 相同"

# ===== 国产模型（可选，不配则对应模型返回 503）=====
# QWEN_API_KEY="sk-..."     # 阿里云百炼国际站 Model Studio（新加坡）
# KIMI_API_KEY="sk-..."     # Moonshot 国际站 platform.kimi.ai

# 人民币结算（均可不填）
# USD_CNY_RATE="7.0"          # 固定汇率，上游美元成本按此换算
# SIGNUP_BONUS_CNY="30"       # 注册赠送额度（元）
# REPORT_TZ="Asia/Shanghai"   # 管理后台按此时区划分「一天」
