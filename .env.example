# 复制为 .env 并填入真实值（切勿提交到 git / 分享给任何人）
DATABASE_URL="postgresql://用户:密码@主机:6543/postgres"  # Supabase 的 Transaction pooler 连接串
AUTH_SECRET="请替换为随机长字符串，可用 openssl rand -base64 32 生成"
ANTHROPIC_API_KEY="sk-ant-..."
DEEPSEEK_API_KEY="sk-..."

# 可选：验证码真实发送渠道（不配置则为开发模式，验证码打印在服务器控制台）
# RESEND_API_KEY="re_..."        # 邮箱验证码，https://resend.com 免费额度即可
# MAIL_FROM="noreply@你的域名"
# SMS_ACCESS_KEY=""              # 手机短信：需阿里云/腾讯云短信签名审批后接入

# 管理员账号（逗号分隔）。用该邮箱/手机号正常注册登录后，即可访问 /admin 管理后台
ADMIN_ACCOUNTS="you@example.com"
